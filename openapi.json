    "/api/v1/jobs": {
      "post": {
        "tags": ["Jobs"],
        "summary": "Create job",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/JobCreateRequest" },
                  {
                    "type": "object",
                    "properties": {
                      "companyLogo": { "type": "string", "format": "binary" }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": { "201": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/api/v1/jobs/all": {
      "get": {
        "tags": ["Jobs"],
        "summary": "List jobs",
        "parameters": [
          { "$ref": "#/components/parameters/KeywordQuery" },
          { "$ref": "#/components/parameters/CategoryQuery" },
          { "$ref": "#/components/parameters/JobTypeQuery" },
          { "$ref": "#/components/parameters/SalaryMinQuery" },
          { "$ref": "#/components/parameters/SalaryMaxQuery" },
          { "$ref": "#/components/parameters/ExperienceLevelQuery" },
          { "$ref": "#/components/parameters/LocationQuery" },
          { "$ref": "#/components/parameters/StatusQuery" },
          { "$ref": "#/components/parameters/PageQuery" },
          { "$ref": "#/components/parameters/LimitQuery" }
        ],
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/api/v1/jobs/saved": {
