          {
            "name": "endDate",
            "in": "query",
            "schema": { "type": "string", "format": "date-time" }
          },
          { "$ref": "#/components/parameters/KeywordQuery" },
          { "$ref": "#/components/parameters/PageQuery" },
          { "$ref": "#/components/parameters/AppLimitQuery" }
