          { "$ref": "#/components/parameters/PageQuery" },
          { "$ref": "#/components/parameters/SavedLimitQuery" }
        ],
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "tags": ["Jobs"],
        "summary": "Get job by id",
        "parameters": [{ "$ref": "#/components/parameters/ObjectIdPathParam" }],
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "patch": {
        "tags": ["Jobs"],
        "summary": "Update job",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ObjectIdPathParam" }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/JobUpdateRequest" },
                  {
                    "type": "object",
                    "properties": {
                      "companyLogo": { "type": "string", "format": "binary" }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "delete": {
        "tags": ["Jobs"],
        "summary": "Delete job",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ObjectIdPathParam" }],
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/api/v1/jobs/{id}/save": {
      "post": {
        "tags": ["Jobs"],
        "summary": "Save job",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ObjectIdPathParam" }],
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "delete": {
        "tags": ["Jobs"],
