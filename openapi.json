            "application/json": {
              "schema": { "$ref": "#/components/schemas/ContactRequest" }
            }
          }
        },
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refreshToken"
      }
    },
    "parameters": {
      "ObjectIdPathParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ObjectId" }
      },
      "KeywordQuery": {
        "name": "keyword",
        "in": "query",
        "schema": { "type": "string", "maxLength": 120 }
      },
      "CategoryQuery": {
        "name": "category",
        "in": "query",
        "schema": { "type": "string", "maxLength": 80 }
      },
      "JobTypeQuery": {
        "name": "jobType",
        "in": "query",
        "schema": { "$ref": "#/components/schemas/JobType" }
      },
      "SalaryMinQuery": {
        "name": "salaryMin",
        "in": "query",
        "schema": { "type": "number", "minimum": 0 }
      },
      "SalaryMaxQuery": {
        "name": "salaryMax",
        "in": "query",
        "schema": { "type": "number", "minimum": 0 }
      },
      "ExperienceLevelQuery": {
        "name": "experienceLevel",
        "in": "query",
        "schema": { "type": "string", "maxLength": 60 }
      },
      "LocationQuery": {
        "name": "location",
        "in": "query",
        "schema": { "type": "string", "maxLength": 120 }
      },
      "StatusQuery": {
        "name": "status",
        "in": "query",
        "schema": { "$ref": "#/components/schemas/JobStatus" }
      },
      "PageQuery": {
        "name": "page",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "LimitQuery": {
        "name": "limit",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 10 }
      },
      "SavedLimitQuery": {
        "name": "limit",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 }
      },
      "AppLimitQuery": {
        "name": "limit",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 }
      }
    },
    "responses": {
      "Success": {
        "description": "Successful response",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiResponse" }
          }
        }
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": ["string", "null"] },
          "data": {}
        },
        "required": ["success", "message", "data"]
      },
      "ObjectId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{24}$"
      },
      "StrongPassword": {
        "type": "string",
        "minLength": 8,
        "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[!@#$%^&*(),.?\":{}|<>]).+$"
      },
      "JobType": {
        "type": "string",
        "enum": ["Full-Time", "Contract", "Part-Time", "Internship", "Freelance"]
      },
      "JobStatus": {
        "type": "string",
        "enum": ["active", "draft", "closed"]
      },
      "ApplicationStatus": {
        "type": "string",
        "enum": ["submitted", "in_review", "shortlisted", "interview", "offer", "rejected", "hired"]
      },
      "SignUpRequest": {
        "type": "object",
        "properties": {
          "fullname": { "type": "string", "minLength": 3 },
          "email": { "type": "string", "format": "email" },
          "password": { "$ref": "#/components/schemas/StrongPassword" }
        },
        "required": ["fullname", "email", "password"]
      },
      "SignInRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "$ref": "#/components/schemas/StrongPassword" }
        },
        "required": ["email", "password"]
      },
      "VerifyAccountRequest": {
        "type": "object",
        "properties": {
          "verificationToken": { "type": "string", "minLength": 6, "maxLength": 6 }
        },
        "required": ["verificationToken"]
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" }
        },
        "required": ["email"]
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "passwordResetToken": { "type": "string", "minLength": 6, "maxLength": 6 },
          "password": { "$ref": "#/components/schemas/StrongPassword" },
          "confirmPassword": { "$ref": "#/components/schemas/StrongPassword" }
        },
        "required": ["email", "passwordResetToken", "password", "confirmPassword"]
      },
      "UpdatePasswordRequest": {
        "type": "object",
        "properties": {
          "password": { "$ref": "#/components/schemas/StrongPassword" },
          "newPassword": { "$ref": "#/components/schemas/StrongPassword" },
          "confirmPassword": { "$ref": "#/components/schemas/StrongPassword" }
        },
        "required": ["password", "newPassword", "confirmPassword"]
      },
      "UserProfilePatchRequest": {
        "type": "object",
        "properties": {
          "fullname": { "type": "string", "minLength": 3 },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string", "minLength": 10 },
          "dateOfBirth": { "type": "string" },
          "country": { "type": "string" },
          "bio": { "type": "string", "maxLength": 1000 }
        }
      },
      "AdminProfileRequest": {
        "type": "object",
        "properties": {
          "fullname": { "type": "string", "minLength": 3 },
          "email": { "type": "string", "format": "email" }
        },
        "required": ["fullname", "email"]
      },
      "SalaryRange": {
        "type": "object",
        "properties": {
          "min": { "type": "number", "minimum": 0 },
          "max": { "type": "number", "minimum": 0 }
        },
        "required": ["min", "max"]
      },
      "JobBase": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 3, "maxLength": 120 },
          "location": { "type": "string", "minLength": 2, "maxLength": 120 },
          "jobType": { "$ref": "#/components/schemas/JobType" },
          "category": { "type": "string", "minLength": 2, "maxLength": 80 },
          "experienceLevel": { "type": "string", "minLength": 2, "maxLength": 60 },
          "jobDescription": { "type": "string", "minLength": 20, "maxLength": 5000 },
          "responsibilities": {
            "type": "array",
            "items": { "type": "string", "minLength": 2, "maxLength": 500 },
            "minItems": 1
          },
          "requirement": {
            "type": "array",
            "items": { "type": "string", "minLength": 2, "maxLength": 500 },
            "minItems": 1
          },
          "benefits": {
            "type": "array",
            "items": { "type": "string", "maxLength": 500 },
            "default": []
          },
          "salaryRange": { "$ref": "#/components/schemas/SalaryRange" },
          "companyName": { "type": "string", "minLength": 2, "maxLength": 120 },
          "companyWebsite": { "type": "string", "format": "uri" },
          "applicationQuestions": {
            "type": "array",
            "items": { "type": "string", "maxLength": 300 },
            "default": []
          },
          "status": { "$ref": "#/components/schemas/JobStatus" }
        }
      },
      "JobCreateRequest": {
        "allOf": [
          { "$ref": "#/components/schemas/JobBase" },
          {
            "type": "object",
            "required": [
              "title",
              "location",
              "jobType",
              "category",
              "experienceLevel",
              "jobDescription",
              "responsibilities",
              "requirement",
              "salaryRange",
              "companyName"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["active", "draft", "closed"],
                "default": "draft"
              }
            }
          }
        ]
      },
      "JobUpdateRequest": {
        "allOf": [{ "$ref": "#/components/schemas/JobBase" }]
      },
      "ApplicationStatusUpdateRequest": {
        "type": "object",
        "properties": {
          "status": { "$ref": "#/components/schemas/ApplicationStatus" },
          "note": { "type": "string", "maxLength": 1000 }
        },
        "required": ["status"]
      },
      "ApplicationNoteUpdateRequest": {
        "type": "object",
        "properties": {
          "note": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "required": ["note"]
      },
      "ApplicationPersonalInfoRequest": {
        "type": "object",
        "properties": {
          "personalInfo": {
            "type": "object",
            "properties": {
              "firstname": { "type": "string", "minLength": 1 },
              "lastname": { "type": "string", "minLength": 1 },
              "email": { "type": "string", "format": "email" },
              "phone": { "type": "string" },
              "currentLocation": { "type": "string" }
            },
            "required": ["firstname", "lastname", "email"]
          }
        },
        "required": ["personalInfo"]
      },
      "SubmitInterviewRequest": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "answer": { "type": "string", "minLength": 1 }
              },
              "required": ["answer"]
            }
          }
        },
        "required": ["answers"]
      },
      "ContactRequest": {
        "type": "object",
        "properties": {
          "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
          "email": { "type": "string", "format": "email" },
          "subject": { "type": "string", "minLength": 3, "maxLength": 200 },
          "message": { "type": "string", "minLength": 10, "maxLength": 4000 }
        },
        "required": ["fullName", "email", "subject", "message"]
      }
    }
  }
}
